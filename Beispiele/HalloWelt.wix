
prozedur ZK::Länge(zk)
auf
    tu länge = 0;
    solang *(zk+länge) != ›\0‹
    auf
        tu länge = länge + 1;
    zu

    rück länge;
zu


konstant STD_OUTPUT_HANDLE = -11;

prozedur Druck(nachricht)
auf
    tu griff = GetStdHandel(STD_OUTPUT_HANDLE);
    tu geschrieben = 0;
    tu länge = ZK::Länge(nachricht);

    tu erfolg = WriteFile(griff, nachricht, länge, &geschrieben);

    rück erfolg;
zu


prozedur Haupt()
auf
    Druck(»Hello, Welt!«);
zu




