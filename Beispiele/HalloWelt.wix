
prozedur ZK::Länge(zk)
auf
    tu länge = 0;
    solang zk.länge != ›\0‹
    auf
        tu länge = länge + 1;
    zu

    rück länge;
zu


prozedur Druck(nachricht)
auf
    tu STD_OUTPUT_HANDLE = 0 - 11;
    tu griff = GetStdHandel(STD_OUTPUT_HANDEL);
    tu geschrieben;
    tu länge = ZK::Länge(nachricht);

    tu erfolg = WriteFile(griff, nachricht, länge, &geschrieben);

    rück erfolg;
zu


prozedur Haupt()
auf
    Druck(»Hello, Welt!«);
zu



