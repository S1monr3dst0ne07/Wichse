
schließ »Bücher/Einbindung.wix« ein

prozedur ZK§Länge(zk)
auf
    tu länge = 0;
    solang b(zk+länge)
    auf
        tu länge = länge + 1;
    zu

    rück länge;
zu

prozedur ZK§Druck(nachricht)
auf
    tu länge = ZK§Länge(nachricht);
    tu erfolg = SchreibDatei(
        NimStdGriff(-11),
        nachricht, 
        länge, 
        0,
    );

    rück erfolg;
zu


prozedur aus(zahl)
auf
    tu h = NimProzessHaufen();
    tu puffer = HaufenZuweise(h, 0, 256);
    tu i = 255;

    tu b(i+puffer) = ›\0‹;
    tu i = i - 1;
    tu b(i+puffer) = ›\z‹;

    falls zahl == 0 
    auf
        tu i = i - 1;
        tu b(i+puffer) = ›0‹;
    zu

    solang zahl
    auf
        tu i = i - 1;
        tu b(i+puffer) = ›0‹ + (zahl % 10);
        tu zahl = zahl / 10;
    zu

    ZK§Druck(i+puffer);
    HaufenAbweise(h, 0, puffer);
zu


prozedur ZK§VonZahl(zahl)
auf
    tu puffer = HaufenZuweise(NimProzessHaufen(), 0, 256);
    tu index = 255;

    tu b(puffer+index) = ›\0‹;
    
    solang zahl
    auf
        tu index = index - 1;
        tu b(puffer+index) = (zahl % 10) + ›0‹;
        tu zahl = zahl / 10;
    zu

    rück puffer+index;
zu


prozedur ZK§Copier(ziel, quelle)
auf
    tu start = quelle;

    solang b(quelle)
    auf
        tu b(ziel) = b(quelle);
        tu ziel   = ziel   + 1;
        tu quelle = quelle + 1;
    zu

    rück quelle - start;
zu



prozedur ZK§Formatier(puffer, muster, parameter)
auf
    tu puffer_index = 0;
    tu muster_index = 0;

    solang b(muster_index+muster)
    auf
        tu zeichen = b(muster_index+muster);

        falls zeichen != ›%‹
        auf
            tu b(puffer+puffer_index) = zeichen;
            tu puffer_index = puffer_index + 1;
        zu

        falls zeichen == ›%‹
        auf
            tu muster_index = muster_index + 1;
            tu platzhalter = b(muster+muster_index);

            falls platzhalter == ›d‹
            auf
                tu number = ZK§VonZahl(q(parameter));
                tu puffer_index = puffer_index + 
                    ZK§Copier(puffer+puffer_index, number);
            zu

            falls platzhalter == ›s‹
            auf
                tu zk = q(parameter);
                tu puffer_index = puffer_index + 
                    ZK§Copier(puffer+puffer_index, zk);
            zu

            tu parameter = parameter + 8; 
        zu

        
        tu muster_index = muster_index + 1;
    zu

    tu b(puffer+puffer_index) = ›\0‹;
zu


