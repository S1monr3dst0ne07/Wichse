
schließ »Bücher/Einbindung.wix« ein

prozedur ZK§Länge(zk: 8)
auf
    tu länge = 0;
    solang (*(zk+länge)) & 255
    auf
        tu länge = länge + 1;
    zu

    rück länge;
zu

prozedur ZK§Druck(nachricht: 8)
auf
    tu länge = ZK§Länge(nachricht);
    tu erfolg = SchreibDatei(
        NimStdGriff(-11),
        nachricht, 
        länge, 
        0,
    );

    rück erfolg;
zu





