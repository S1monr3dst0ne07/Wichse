
schließ »Bücher/Fenster.wix« ein

prozedur ZK§Länge(zk)
auf
    tu länge = 0;
    solang (*(zk+länge)) & 255
    auf
        tu länge = länge + 1;
    zu

    rück länge;
zu

prozedur ZK§Druck(nachricht)
auf
    tu länge = ZK§Länge(nachricht);
    tu test = Fenster§STANDARD_AUSGABE_GRIFF;
    tu erfolg = aus SchreibDatei(
        test,
        nachricht, 
        länge, 
        0,
    );

    rück erfolg;
zu





