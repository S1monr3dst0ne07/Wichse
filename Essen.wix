

schließ »Bücher/Einbindung.wix« ein
schließ »Bücher/ZK.wix« ein
schließ »Bücher/Fenster.wix« ein
schließ »Bücher/Haufen.wix« ein

schema Kontext
auf
    Instanz : 8,
    HaufenGriff : 8,

    FenGriffEingabe : 8,
    FenGriffHin : 8,
    FenGriffEss : 8,
    FenGriffWeg : 8,
    FenGriffListe : 8,

    Datenbank : 8,
zu

global kontext
prozedur MachKontext()
auf
    tu Instanz = NimModulGriff();
    tu HaufenGriff = NimProzessHaufen();

    tu kontext = HaufenZuweise(HaufenGriff, Haufen§NULL_SETZ, Kontext);
    tu kontext.Kontext§Instanz = Instanz;
    tu kontext.Kontext§HaufenGriff = HaufenGriff;

    LadeDatenbank();
zu

konstant ID_LISTE       = 1001;
konstant ID_HIN         = 1002;
konstant ID_ESS         = 1003;
konstant ID_WEG         = 1004;
konstant ID_EINGABE     = 1005;


schema Datenpunkt
auf
    Essen : 8,
    Jahr  : 4,
    Monat : 4,
    Tag   : 4,
    NächsterPunkt : 8,
zu

prozedur MachDatenpunkt()
auf
    tu dp = HaufenZuweise(kontext.Kontext§HaufenGriff, 0, Datenpunkt);
    tu dp.Datenpunkt§Essen = HaufenZuweise(kontext.Kontext§HaufenGriff, 0, 4096);
    tu dp.Datenpunkt§Jahr          = 0;
    tu dp.Datenpunkt§Monat         = 0;
    tu dp.Datenpunkt§Tag           = 0;
    tu dp.Datenpunkt§NächsterPunkt = 0;
    rück dp;
zu


konstant DBZ_NAME = 0;
konstant DBZ_JAHR = 1;
konstant DBZ_MONAT = 2;
konstant DBZ_TAG = 3;

prozedur LadeDatenbank()
auf
    tu müll = HaufenZuweise(kontext.Kontext§HaufenGriff, 0, Fenster§DateiBehälter+128);
    tu griff = ÖffneDatei(»essen-datenbank.txt«, müll, Fenster§DATEI§LESE);

    falls griff == 4294967295
    auf
        ZK§Druck(»Datei »essen-datenbank.txt« nicht gefunden.\z«);
        SchließProzess(1);
    zu

    tu größe = NimDateiGröße(griff, 0); 
    tu datei = HaufenZuweise(kontext.Kontext§HaufenGriff, Haufen§NULL_SETZ, größe+1);
    LeseDatei(griff, datei, größe, 0, 0);

    tu dp = MachDatenpunkt();
    tu namen_index = 0;
    
    tu index = 0;
    tu zustand = DBZ_NAME;
    solang index < größe
    auf
        tu zeichen = b(index+datei);

        tu normal = 1;
        falls zeichen == ›,‹
        auf 
            tu zustand = zustand + 1; 
            tu normal = 0;
        zu

        falls (zeichen == ›\z‹) & (zustand == DBZ_TAG)
        auf
            tu neu_dp = MachDatenpunkt();

            tu b((dp.Datenpunkt§Essen)+namen_index) = ›\0‹;
            tu neu_dp.Datenpunkt§NächsterPunkt = dp;

            tu dp = neu_dp;
            tu namen_index = 0;
            tu zustand = 0;
        zu

        falls normal
        auf
            falls zustand == DBZ_NAME
            auf
                tu b((dp.Datenpunkt§Essen)+namen_index) = zeichen;
                tu namen_index = namen_index + 1;
            zu

            falls zustand != DBZ_NAME
            auf
                tu x = 0;
                falls zustand == DBZ_JAHR  auf tu x = dp.Datenpunkt§Jahr;  zu
                falls zustand == DBZ_MONAT auf tu x = dp.Datenpunkt§Monat; zu
                falls zustand == DBZ_TAG   auf tu x = dp.Datenpunkt§Tag;   zu

                tu x = (x * 10) + (zeichen - ›0‹);

                falls zustand == DBZ_JAHR  auf tu dp.Datenpunkt§Jahr  = x; zu
                falls zustand == DBZ_MONAT auf tu dp.Datenpunkt§Monat = x; zu
                falls zustand == DBZ_TAG   auf tu dp.Datenpunkt§Tag   = x; zu
            zu
        zu

        tu index = index + 1;
    zu

    tu kontext.Kontext§Datenbank = dp.Datenpunkt§NächsterPunkt;
zu



prozedur ErneuerList()
auf
    SchickNachricht(
        kontext.Kontext§FenGriffListe,
        Fenster§LISTE§LEER,
        0, 0
    );

    tu zeile = HaufenZuweise(kontext.Kontext§HaufenGriff, 0, 4096);
    tu dp = kontext.Kontext§Datenbank;

    solang dp
    auf
        ZK§Druck(dp.Datenpunkt§Essen); aus(0);

        tu dp = dp.Datenpunkt§NächsterPunkt;
    zu
    
zu



prozedur Erzeuge(griff)
auf
    tu kontext.Kontext§FenGriffEingabe = KreiereFenster(
        Fenster§ART§GESUNKENE_ECKE 
        »EDIT«,
        »«,
        Fenster§ART§KIND | Fenster§ART§SICHTBAR,
        10, 10, 400, 28,
        griff,
        ID_EINGABE,
        0, 0
    );

    tu kontext.Kontext§FenGriffHin = KreiereFenster(
        0,
        »BUTTON«,
        »Hinzufügen«,
        Fenster§ART§KIND | Fenster§ART§SICHTBAR,
        420, 10, 100, 28,
        griff,
        ID_HIN,
        0,
        0
    );

    tu kontext.Kontext§FenGriffEss = KreiereFenster(
        0,
        »BUTTON«,
        »Heute Gegessen«,
        Fenster§ART§KIND | Fenster§ART§SICHTBAR,
        530, 10, 120, 28,
        griff,
        ID_ESS,
        0,
        0
    );

    tu kontext.Kontext§FenGriffWeg = KreiereFenster(
        0,
        »BUTTON«,
        »Wegmachen«,
        Fenster§ART§KIND | Fenster§ART§SICHTBAR,
        660, 10, 95, 28,
        griff,
        ID_WEG,
        0,
        0
    );

    tu kontext.Kontext§FenGriffListe = KreiereFenster(
        Fenster§ART§GESUNKENE_ECKE,
        »LISTBOX«,
        »«,
        Fenster§ART§KIND | 
        Fenster§ART§SICHTBAR |
        Fenster§ART§VSCROLL |
        Fenster§ART§HSCROLL,
        10, 50, 745, 400,
        griff,
        ID_LISTE,
        0,
        0
    );


    ErneuerList();
zu


prozedur FenProz(griff, nachricht, wort_param, lang_param)
auf
    falls nachricht == Fenster§NACHRICHT§ERZEUGE
    auf Erzeuge(griff); rück 0; zu

    falls nachricht == Fenster§NACHRICHT§ZERSTÖR
    auf NachZerstör(0); rück 0; zu

    VorgabeFensterProz(griff, nachricht, wort_param, lang_param);
zu


prozedur Haupt()
auf
    MachKontext();

    tu FenKls = HaufenZuweise(kontext.Kontext§HaufenGriff, Haufen§NULL_SETZ, Fenster§Klasse);
    tu FenKls.Fenster§Klasse§Größe = Fenster§Klasse;
    tu FenKls.Fenster§Klasse§zFensterProz = FenProz;
    tu FenKls.Fenster§Klasse§zzKlassenName = »EssenHelfer«;
    tu FenKls.Fenster§Klasse§Eingabemarke = LadeEingabemarke(0, Fenster§ID§ZEIGER);
    tu FenKls.Fenster§Klasse§Hintergrund = 6;

    tu a = RegistriereKlasse(FenKls);
    falls a == 0 auf SchließProzess(1); zu

    tu FensterGriff = KreiereFenster(
        0,
        »EssenHelfer«,
        »Essen Helfer«,
        Fenster§ART§ÜBERSCHRIFT | Fenster§ART§MENÜ,
        Fenster§KF§NIM_NORMAL,
        Fenster§KF§NIM_NORMAL,
        770, 480,
        0, 0, kontext.Kontext§Instanz, 0
    );

    ZeigeFenster(FensterGriff, 1);

    tu nachricht = HaufenZuweise(kontext.Kontext§HaufenGriff, 0, Fenster§Nachricht);
    solang NimNachricht(nachricht, 0, 0, 0) > 0
    auf
        ÜbersetzteNachricht(nachricht);
        AbfertigeNachricht(nachricht);
    zu

    SchließProzess(0);
zu
